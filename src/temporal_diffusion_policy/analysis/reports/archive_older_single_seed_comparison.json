{
  "name": "archive_older_single_seed_comparison",
  "study": "tc_dp_paper",
  "environments": [
    "WaitAtGoal",
    "LiftQA",
    "LiftQA-Real"
  ],
  "methods": [
    "DP",
    "DP+PIP",
    "PTP",
    "TC-DP (ID+SaP)",
    "TC-DP (ID+SiP)"
  ],
  "metrics": [
    "W_pause",
    "W_episode",
    "W_total",
    "success_rate"
  ],
  "aggregation": "none",
  "confidence_interval": null,
  "required_training_seeds": [],
  "expected_episodes": {
    "WaitAtGoal": 200,
    "LiftQA": 200,
    "LiftQA-Real": 50
  },
  "allow_missing": {
    "LiftQA-Real": [
      "PTP"
    ]
  },
  "analysis": {
    "winsorize_durations": true,
    "winsorize_using_demo_distribution": false
  },
  "format": {
    "labels": {
      "DP": "DP~\\cite{chi_diffusion_2024}",
      "DP+PIP": "PIP~\\cite{chen_exploiting_2025}",
      "PTP": "PTP~\\cite{torne_past-token_2025}"
    },
    "gray_metrics": [
      "W_pause",
      "W_episode"
    ],
    "bold_best": [
      "W_total"
    ],
    "precision": {
      "success_rate": 1
    }
  },
  "figures": {
    "include_training_parameters": false,
    "aggregate_histograms_by_key": true
  },
  "output": "outputs/analysis/reports/archive_older_single_seed_comparison.tex"
}
