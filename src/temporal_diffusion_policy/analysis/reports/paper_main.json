{
  "name": "paper_main",
  "study": "tc_dp_paper_multiseed",
  "environments": [
    "WaitAtGoal",
    "LiftQA",
    "LiftQA-Real"
  ],
  "methods": [
    "DP",
    "DP+PIP",
    "PTP",
    "TC-DP (ID+SaP)",
    "TC-DP (ID+SiP)"
  ],
  "metrics": [
    "W_pause",
    "W_episode",
    "W_total",
    "success_rate"
  ],
  "aggregation": "mean",
  "required_training_seeds": [
    1,
    2,
    3
  ],
  "expected_episodes": {
    "WaitAtGoal": 200,
    "LiftQA": 200,
    "LiftQA-Real": 50
  },
  "allow_missing": {
    "LiftQA-Real": [
      "PTP"
    ]
  },
  "analysis": {
    "winsorize_durations": true,
    "winsorize_using_demo_distribution": false
  },
  "format": {
    "labels": {
      "DP": "DP~\\cite{chi_diffusion_2024}",
      "DP+PIP": "PIP~\\cite{chen_exploiting_2025}",
      "PTP": "PTP~\\cite{torne_past-token_2025}"
    },
    "gray_metrics": [
      "W_pause",
      "W_episode"
    ],
    "bold_best": [
      "W_total",
      "success_rate"
    ],
    "precision": {
      "W_pause": 2,
      "W_episode": 2,
      "W_total": 2,
      "success_rate": 1
    },
    "underline_second": [
      "W_total",
      "success_rate"
    ],
    "headers": {
      "success_rate": "SR (\\%)"
    },
    "compact_ci": true,
    "environment_spacing": {
      "LiftQA-Real": 4
    },
    "row_spacing_pt": 3,
    "math_cells": true
  },
  "figures": {
    "include_training_parameters": false,
    "aggregate_histograms_by_key": true,
    "aggregate_uncertainty": "standard_deviation"
  },
  "output": "outputs/analysis/reports/paper_main.tex",
  "training_seeds_by_method": {
    "PTP": [
      42,
      43,
      44
    ]
  },
  "environment_overrides": {
    "LiftQA-Real": {
      "study": "tc_dp_paper",
      "aggregation": "none",
      "confidence_interval": null,
      "required_training_seeds": [],
      "training_seeds_by_method": {},
      "uncertainty": null
    }
  },
  "uncertainty": "standard_deviation"
}
